    def test_http_queries_with_native_records_are_sqlite_readonly(self):
        self.submit()
        before = self.route()
        order,deal = self.order(m_nOrderStatus=56),self.deal()
        self.s.get_trade_detail_data.side_effect = lambda account,scope,kind:[order] if kind=='order' else [deal]
        connect = sqlite3.connect
        denied = {sqlite3.SQLITE_INSERT,sqlite3.SQLITE_UPDATE,sqlite3.SQLITE_DELETE,
                  sqlite3.SQLITE_CREATE_TABLE,sqlite3.SQLITE_DROP_TABLE}
        attempts = []
        def authorize(action,*rest):
            if action in denied:
                attempts.append(action)
                return sqlite3.SQLITE_DENY
            return sqlite3.SQLITE_OK
        def read_only(*args,**kwargs):
            conn = connect(*args,**kwargs)
            conn.set_authorizer(authorize)
            return conn
        # RPC传输在本测试内同步桥接到真实execute_rpc；独立线程亲和性已有专门用例。
        with mock.patch.object(self.s.sqlite3,'connect',side_effect=read_only), \
                mock.patch.object(self.s,'call_qmt',side_effect=lambda path,params:self.invoke(self.s.execute_rpc,path,params)):
            for path in ('/orders?request_id=fake_request','/orders?account_type=normal',
                         '/trades?account_type=normal','/trade/ledger?request_id=fake_request'):
                with self.subTest(path=path):
                    h = self.handler(path)
                    h.dispatch()
                    h.send_response.assert_called_once_with(200)
                    self.assertEqual(json.loads(h.wfile.getvalue())['status'],'success')
        self.assertEqual(attempts,[])
        self.assertEqual(self.route(),before)
        self.assertEqual(self.s.ledger({})['data'],[])
        self.s.passorder.assert_called_once()

