# -*- coding: utf-8 -*-
"""标准桥接隔离回归：仅加载同目录源码；绝不访问部署模型或正式数据库。

运行：python -B -m unittest discover -s qmt_bridge_standard -p test_server.py -v
所有网络监听均为127.0.0.1:0；passorder始终被Mock截获。
"""
import datetime as dt
import http.client
import io
import json
import pathlib
import queue
import sqlite3
import threading
import types
import unittest
from collections import deque
from tempfile import TemporaryDirectory
from unittest import mock

SOURCE = pathlib.Path(__file__).with_name('qmt_bridge_server.py')


def load_server():
    # 导出服务端为GBK；仅规范内存首行，不改部署文件。
    source = SOURCE.read_text(encoding='gbk').splitlines(True)
    source[0] = '# -*- coding: utf-8 -*-\n'
    module = types.ModuleType('isolated_standard_server')
    module.__file__ = str(SOURCE)
    exec(compile(''.join(source), str(SOURCE), 'exec'), module.__dict__)
    return module


class FrozenDatetime(dt.datetime):
    @classmethod
    def now(cls, tz=None):
        return cls(2026, 9, 4, 10, 0, 0, tzinfo=tz)


class FakeFrame:
    def iterrows(self):
        return iter([('20260903', {'close': 12.5, 'volume': 100, 'open': float('nan')})])


class FakeContext:
    def __init__(self):
        self.set_account = mock.Mock()
        self.run_time = mock.Mock()
        self.get_trading_dates = mock.Mock(side_effect=lambda code, start, end, count, period: [start])
        self.get_full_tick = mock.Mock(return_value={'000001.SZ': {'lastPrice': 12.5}})
        self.get_market_data_ex = mock.Mock(return_value={'000001.SZ': FakeFrame()})
        self.account = 'FAKE_STALE_DISABLED_ACCOUNT'


class ServerTests(unittest.TestCase):
    def setUp(self):
        self.tmp = TemporaryDirectory(prefix='qmt_standard_unittest_')
        self.addCleanup(self.tmp.cleanup)
        self.s = load_server()
        self.s.datetime = FrozenDatetime
        self.s.BRIDGE_HOST, self.s.BRIDGE_PORT = '127.0.0.1', 0
        self.s.NORMAL_ACCOUNT_ID = 'FAKE_NORMAL'
        self.s.CREDIT_ACCOUNT_ID = 'FAKE_CREDIT'
        self.s.ENABLE_NORMAL_ACCOUNT = self.s.ENABLE_CREDIT_ACCOUNT = True
        self.s.DB_PATH = str(pathlib.Path(self.tmp.name) / 'isolated.sqlite3')
        self.s.BRIDGE_ALLOW_LIVE_ORDERS = True
        self.s.passorder = mock.Mock(return_value=0)
        self.s.get_trade_detail_data = mock.Mock(return_value=[])
        self.ctx = FakeContext()
        self.s.init(self.ctx)
        self.addCleanup(self.s.stop, self.ctx)

    def invoke(self, function, *args, **kwargs):
        with self.s.callback_scope(self.ctx):
            return function(*args, **kwargs)

    def test_timer_registered_in_init_with_historical_start_and_live_heartbeat(self):
        self.ctx.run_time.assert_called_once_with('qmt_timer_callback','1nSecond',self.s.TIMER_START_TIME)
        self.assertLess(dt.datetime.strptime(self.s.TIMER_START_TIME,'%Y-%m-%d %H:%M:%S'),FrozenDatetime.now())
        self.assertFalse(self.s.health()['rpc_ready'])
        self.s.handlebar(self.ctx)
        self.assertEqual(self.s.health()['timer_count'],0)
        self.s.qmt_timer_callback(self.ctx)
        self.assertTrue(self.s.health()['rpc_ready'])
        self.assertEqual(self.s.health()['timer_count'],1)
        self.assertEqual(self.s.health()['last_timer_at'],'2026-09-04 10:00:00')
        with mock.patch.object(self.s,'start_server'):
            self.s.after_init(self.ctx)
        self.ctx.run_time.assert_called_once()

    def params(self, **changes):
        value = dict(account_type='normal', stock_code='000001.SZ', action='BUY',
                     price=12.5, volume=100, strategy_name='fake_strategy',
                     user_order_id='fake_request', dry_run=False, confirm_live_order='LIVE_ORDER')
        value.update(changes)
        return value

    def submit(self, **changes):
        return self.invoke(self.s.submit_order, self.params(**changes))['data']

    def sql(self, statement, args=()):
        # 显式关闭连接，保证Windows临时目录清理不受SQLite句柄影响。
        with self.s.database(True) as conn:
            return [dict(row) for row in conn.execute(statement, args).fetchall()]

    def route(self, request='fake_request'):
        return self.sql('SELECT * FROM bridge_requests WHERE request_id=?', (request,))[0]

    def deal(self, route=None, **changes):
        r = route or self.route()
        value = dict(m_strAccountID=r['account_id'], m_strInstrumentID='000001',
                     m_strExchangeID='SZ', m_strOrderSysID='FAKE_ORDER', m_strTradeID='FAKE_DEAL',
                     m_strTradeDate=r['trade_date'], m_strTradeTime='10:00:01',
                     m_strRemark=r['broker_remark'], m_nOffsetFlag=48 if r['action']=='BUY' else 49,
                     m_nDirection=48, m_nVolume=40, m_dPrice=12.5, m_dTradeAmount=500.0)
        value.update(changes)
        return types.SimpleNamespace(**value)

    def order(self, route=None, **changes):
        r = route or self.route()
        value = vars(self.deal(r)).copy()
        value.pop('m_strTradeDate')
        value.update(m_strInsertDate=r['trade_date'], m_strInsertTime='10:00:00',
                     m_nVolumeTotalOriginal=r['volume'], m_nVolumeTraded=0,
                     m_dLimitPrice=12.5, m_nOrderStatus=50)
        value.update(changes)
        return types.SimpleNamespace(**value)

    def persist(self, row, deal=True):
        return self.invoke(self.s.persist_callback, row, deal)

    def test_import_has_no_database_network_or_thread_side_effects(self):
        with mock.patch('sqlite3.connect', side_effect=AssertionError('database on import')), \
                mock.patch('socket.socket', side_effect=AssertionError('socket on import')), \
                mock.patch('threading.Thread.start', side_effect=AssertionError('thread on import')):
            s = load_server()
        self.assertFalse(s._running)
        self.assertIsNone(s._server)

    def assert_database_rejected_unchanged(self, path):
        """同时检查初始化及运行期打开路径；拒绝不应修改任何已有数据库字节。"""
        self.s.stop(self.ctx)
        self.s.DB_PATH = str(path)
        before = path.read_bytes()
        with self.assertRaises(ValueError):
            self.s.init(self.ctx)
        self.assertFalse(self.s._running)
        self.assertEqual(path.read_bytes(),before)
        for write in (False,True):
            with self.subTest(write=write), self.assertRaises((ValueError,sqlite3.DatabaseError)):
                with self.s.database(write):
                    self.fail('incompatible database opened')
            self.assertEqual(path.read_bytes(),before)

    def schema_fixture(self, name, statements):
        """从本测试创建的空专用库复制结构，再注入不兼容结构；不读取项目业务库。"""
        path = pathlib.Path(self.tmp.name) / (name+'.sqlite3')
        path.write_bytes(self.valid_schema_bytes)
        conn = sqlite3.connect(str(path))
        try:
            for statement in statements:
                conn.execute(statement)
            conn.commit()
        finally:
            conn.close()
        return path

    def test_missing_source_and_legacy_shape_rejected_unchanged(self):
        self.valid_schema_bytes = pathlib.Path(self.s.DB_PATH).read_bytes()
        # 采用重建表而非SQLite新版DROP COLUMN，保持测试兼容旧SQLite运行库。
        for name,columns in (('missing_source','account_id,trade_date,deal_id,request_id,order_id,price,volume,trade_amount,trade_time'),
                             ('legacy_deals','account_id,deal_id,request_id,volume')):
            with self.subTest(schema=name):
                path = self.schema_fixture(name,[
                    'ALTER TABLE bridge_deals RENAME TO fake_old_deals',
                    'CREATE TABLE bridge_deals AS SELECT '+columns+' FROM fake_old_deals',
                    'DROP TABLE fake_old_deals'])
                self.assert_database_rejected_unchanged(path)

    def test_missing_or_incompatible_unique_partial_index_rejected_unchanged(self):
        self.valid_schema_bytes = pathlib.Path(self.s.DB_PATH).read_bytes()
        variants = {
            'missing':[],
            'not_unique':["CREATE INDEX broker_order_key ON bridge_requests(account_id,trade_date,order_id) WHERE order_id!=''"],
            'not_partial':['CREATE UNIQUE INDEX broker_order_key ON bridge_requests(account_id,trade_date,order_id)'],
            'wrong_columns':["CREATE UNIQUE INDEX broker_order_key ON bridge_requests(account_id,order_id) WHERE order_id!=''"]}
        for name,statements in variants.items():
            with self.subTest(index=name):
                path = self.schema_fixture(name,['DROP INDEX broker_order_key']+statements)
                self.assert_database_rejected_unchanged(path)

    def test_all_table_column_contracts_rejected_unchanged(self):
        self.valid_schema_bytes = pathlib.Path(self.s.DB_PATH).read_bytes()
        for table in ('bridge_meta','bridge_requests','bridge_deals'):
            with self.subTest(table=table):
                path = self.schema_fixture(table,['ALTER TABLE '+table+' ADD COLUMN fake_extra TEXT'])
                self.assert_database_rejected_unchanged(path)

    def test_foreign_database_and_wrong_product_rejected_without_changes(self):
        self.valid_schema_bytes = pathlib.Path(self.s.DB_PATH).read_bytes()
        path = pathlib.Path(self.tmp.name) / 'foreign.sqlite3'
        conn = sqlite3.connect(str(path))
        try:
            conn.execute('CREATE TABLE fake_external_data(value TEXT)')
            conn.execute("INSERT INTO fake_external_data VALUES ('FAKE_KEEP_CONTENT')")
            conn.commit()
        finally:
            conn.close()
        self.assert_database_rejected_unchanged(path)
        path = self.schema_fixture('wrong_product',["UPDATE bridge_meta SET product='FAKE_FOREIGN_PRODUCT'"])
        self.assert_database_rejected_unchanged(path)

