    def test_persistent_request_query_read_only_filters_and_restart(self):
        self.submit()
        before = self.route()
        # SQLite authorizer拒绝一切写操作，同时保留生产database上下文及真实SQL。
        connect = sqlite3.connect
        denied = {sqlite3.SQLITE_INSERT,sqlite3.SQLITE_UPDATE,sqlite3.SQLITE_DELETE,
                  sqlite3.SQLITE_CREATE_TABLE,sqlite3.SQLITE_DROP_TABLE}
        def read_only(*args,**kwargs):
            conn = connect(*args,**kwargs)
            conn.set_authorizer(lambda action,*rest:sqlite3.SQLITE_DENY if action in denied else sqlite3.SQLITE_OK)
            return conn
        with mock.patch.object(self.s.sqlite3,'connect',side_effect=read_only):
            result = self.s.query_request({'request_id':'fake_request'})
            self.assertEqual(result['source'],'persistent_request')
            self.assertEqual(result['data'][0]['request_id'],'fake_request')
            self.assertNotIn('account_id',result['data'][0])
            for params in ({'request_id':'missing'},{'request_id':'fake_request','account_type':'credit'}):
                self.assertEqual(self.s.query_request(params)['data'],[])
        self.s.stop(self.ctx); self.s.init(self.ctx)
        self.assertEqual(self.s.query_request({'request_id':'fake_request'}),result)
        self.assertEqual(self.route(),before)
        self.s.ENABLE_NORMAL_ACCOUNT = False
        self.assertEqual(self.s.query_request({'request_id':'fake_request'})['data'],[])
        self.s.passorder.assert_called_once()
        self.s.get_trade_detail_data.assert_not_called()

