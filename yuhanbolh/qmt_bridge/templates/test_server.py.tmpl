    def test_partial_duplicate_conflicting_and_excess_deals(self):
        self.submit()
        row = self.deal()
        self.assertEqual(self.persist(row)['ledger_status'],'written')
        self.assertEqual(self.persist(row)['ledger_status'],'duplicate')
        with self.assertRaises(ValueError): self.persist(self.deal(m_nVolume=41))
        with self.assertRaises(ValueError): self.persist(self.deal(m_strTradeID='FAKE_EXCESS',m_nVolume=61))
        self.persist(self.deal(m_strTradeID='FAKE_DEAL_2',m_nVolume=60))
        self.assertEqual(self.route()['remaining'],0)
        self.assertEqual(len(self.s.ledger({})['data']),2)

    def test_account_date_trade_id_composite_deduplication(self):
        self.submit()
        self.persist(self.deal())
        self.submit(account_type='credit',op_type=27,user_order_id='fake_credit')
        self.persist(self.deal(self.route('fake_credit')))
        # 第二交易日通过更换冻结datetime类推进，保留真实门禁和日历调用。
        class NextDay(FrozenDatetime):
            @classmethod
            def now(cls,tz=None): return cls(2026,9,7,10,tzinfo=tz)
        self.persist(self.order(m_nOrderStatus=54),False)
        self.s.datetime = NextDay
        self.submit(user_order_id='fake_next_day')
        row = self.deal(self.route('fake_next_day'))
        self.persist(row)
        self.assertEqual(self.persist(row)['ledger_status'],'duplicate')
        self.assertEqual(len(self.s.ledger({})['data']),3)
        self.assertEqual(len(self.s.ledger({'account_type':'credit'})['data']),1)

