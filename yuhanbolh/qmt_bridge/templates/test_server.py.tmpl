        original = self.s._rpc_queue.put_nowait
        def put(task):
            original(task)
            enqueued.set()
        def tick(codes):
            native_threads.append(threading.get_ident())
            return {'000001.SZ': {'lastPrice':12.5}}
        def client():
            try: result.append(self.s.call_qmt('/tick',{'stock_code':'000001.SZ'}))
            except Exception as exc: errors.append(exc)
        self.ctx.get_full_tick.side_effect = tick
        self.s.RPC_TIMEOUT_SECONDS = 1
        with mock.patch.object(self.s._rpc_queue,'put_nowait',side_effect=put):
            t = threading.Thread(target=client,daemon=True)
            t.start()
            self.assertTrue(enqueued.wait(1))
            self.ctx.get_full_tick.assert_not_called()
            self.invoke(self.s.drain_rpc)
            t.join(1)
        self.assertFalse(t.is_alive())
        self.assertEqual(errors,[])
