    def test_queued_deadline_and_stop_cancel_work_before_restart(self):
        def task(deadline):
            return dict(path='/trade/order',params=self.params(),deadline=deadline,state='queued',
                        lock=threading.Lock(),done=threading.Event())
        expired = task(0)
        self.s._rpc_queue.put_nowait(expired)
        self.invoke(self.s.drain_rpc)
        self.assertTrue(expired['done'].is_set())
        self.assertIsInstance(expired['error'],TimeoutError)
        waiting = task(float('inf'))
        self.s._rpc_queue.put_nowait(waiting)
        self.s.stop(self.ctx)
        self.assertTrue(waiting['done'].is_set())
        self.assertIsInstance(waiting['error'],RuntimeError)
        self.s.init(self.ctx)
        self.invoke(self.s.drain_rpc)
        self.s.passorder.assert_not_called()
        self.assertEqual(self.s._rpc_queue.unfinished_tasks,0)

    def test_thread_start_failure_closes_bound_socket(self):
        server = mock.Mock()
        with mock.patch.object(self.s,'BridgeServer',return_value=server) as constructor, \
                mock.patch.object(self.s.threading.Thread,'start',side_effect=RuntimeError('fake start failure')):
            with self.assertRaises(RuntimeError): self.s.start_server()
        constructor.assert_called_once_with(('127.0.0.1',0),self.s.BridgeHandler)
        server.server_close.assert_called_once()
        self.assertIsNone(self.s._server)


