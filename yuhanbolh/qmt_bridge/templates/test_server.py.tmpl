    def test_running_timeout_no_repeat(self):
        # 注入只控制等待的Event，使“已running但客户端超时”不依赖操作系统调度速度。
        entered, release, enqueued = threading.Event(), threading.Event(), threading.Event()
        class ClientDone:
            def wait(inner, timeout):
                if not entered.wait(1): raise AssertionError('native call did not start')
                return False
            def set(inner): pass
        real_queue = self.s._rpc_queue
        original_put = real_queue.put_nowait
        def put(task):
            task['done'] = ClientDone()
            original_put(task)
            enqueued.set()
        errors = []
        def client():
            try: self.s.call_qmt('/trade/order',self.params())
            except Exception as exc: errors.append(exc)
            finally: release.set()
        def intercept(*args):
            entered.set()
            if not release.wait(1): raise AssertionError('client did not time out')
            return 0
        self.s.passorder.side_effect = intercept
        with mock.patch.object(real_queue,'put_nowait',side_effect=put):
            t = threading.Thread(target=client,daemon=True)
            t.start()
            self.assertTrue(enqueued.wait(1))
            self.invoke(self.s.drain_rpc)
            t.join(1)
        self.assertFalse(t.is_alive())
        self.assertEqual(len(errors),1)
        self.assertIsInstance(errors[0],TimeoutError)
        self.assertIn('执行中',str(errors[0]))
        self.assertTrue(self.submit()['duplicate_request'])
        self.s.passorder.assert_called_once()

