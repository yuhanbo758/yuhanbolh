    def test_start_bind_failure_retry_concurrent_start_stop_start_and_loopback(self):
        with mock.patch.object(self.s,'BridgeServer',side_effect=OSError('fake bind failure')):
            with self.assertRaises(OSError): self.s.start_server()
        self.assertIsNone(self.s._server)
        self.assertIsNone(self.s._server_thread)
        # 缩短HTTPServer空闲轮询，只影响测试停机等待，不修改业务门禁。
        original = self.s.BridgeServer.serve_forever
        with mock.patch.object(self.s.BridgeServer,'serve_forever',lambda server:original(server,poll_interval=0.01)):
            barrier = threading.Barrier(3)
