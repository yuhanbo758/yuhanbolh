    def test_sqlite_abort_rolls_back_deal_binding_and_remaining(self):
        self.submit()
        before = self.route()
        self.sql("CREATE TRIGGER fake_abort BEFORE UPDATE OF remaining ON bridge_requests BEGIN SELECT RAISE(ABORT,'fake abort'); END")
        with self.assertRaises(sqlite3.IntegrityError): self.persist(self.deal())
        self.assertEqual(self.route(),before)
        self.assertEqual(self.s.ledger({})['data'],[])
        self.sql('DROP TRIGGER fake_abort')
        self.assertEqual(self.persist(self.deal())['ledger_status'],'written')
        self.assertEqual(self.route()['remaining'],60)

    def test_synchronous_callback_before_passorder_return(self):
        def intercept(*args):
            self.assertEqual(self.route()['submission_state'],'submitting')
            self.s.deal_callback(self.ctx,self.deal())
            return 0
        self.s.passorder.side_effect = intercept
        result = self.submit()
        self.assertEqual(result['remaining'],60)
        self.assertEqual(result['order_id'],'FAKE_ORDER')
        self.assertEqual(self.s._events[-1]['data']['ledger_status'],'written')
        self.s.passorder.assert_called_once()

