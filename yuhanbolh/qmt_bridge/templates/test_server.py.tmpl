    def test_native_thread_affinity_and_nested_scope(self):
        with self.assertRaises(RuntimeError):
            self.s.market({'stock_code':'000001.SZ'})
        errors = []
        def worker():
            try:
                self.s.market({'stock_code':'000001.SZ'})
            except Exception as exc:
                errors.append(exc)
        with self.s.callback_scope(self.ctx):
            with self.s.callback_scope(self.ctx):
                self.s.require_qmt_thread()
            t = threading.Thread(target=worker)
            t.start(); t.join(1)
            self.assertFalse(t.is_alive())
            self.s.require_qmt_thread()
        self.assertEqual(len(errors), 1)
        self.assertIsInstance(errors[0], RuntimeError)
        self.ctx.get_full_tick.assert_not_called()

